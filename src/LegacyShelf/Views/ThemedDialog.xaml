<Window x:Class="LegacyShelf.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LegacyShelf"
        Width="620"
        SizeToContent="Height"
        MinHeight="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0E121A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="ToneIcon"
                               Text="&#xE7BA;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="15"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Text="LegacyShelf"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right"
                        Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="30,24,30,26">
                <TextBlock x:Name="HeadingText"
                           Text="Heading"
                           FontSize="21"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Margin="0,9,0,0" />
                <Border x:Name="DetailsPanel"
                        Background="#111620"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14,12"
                        Margin="0,16,0,0">
                    <TextBlock x:Name="DetailsText"
                               FontFamily="Consolas"
                               FontSize="11.5"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#0E121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="30,0">
                    <Button x:Name="SecondaryButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click" />
                    <Button x:Name="PrimaryButton"
                            Content="OK"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="Primary_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
