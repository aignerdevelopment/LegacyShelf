<Window x:Class="LegacyShelf.Views.TransportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pack for transport"
        Width="820" Height="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0E121A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                               FontSize="15" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Pack for transport" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,22,30,20">
                    <TextBlock Text="Make a portable set"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Creates one self-contained folder with LegacyShelf, your settings, cover art, and the selected game folders. Copy the whole folder to the new PC and run LegacyShelf.exe — no installer, no store, no account."
                               FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Margin="0,8,0,22" />

                    <TextBlock Text="Destination folder (must not exist yet)"
                               FontSize="12.5" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="40" Background="#111620" BorderThickness="1" CornerRadius="9">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=DestinationTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox x:Name="DestinationTextBox"
                                     Style="{StaticResource FlatTextBoxStyle}"
                                     TextChanged="DestinationTextBox_TextChanged" />
                        </Border>
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40"
                                Margin="10,0,0,0"
                                Click="Browse_Click" />
                    </Grid>
                    <TextBlock x:Name="DestinationStatusText"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,7,0,0"
                               Text="Choose an empty/new folder outside your game library." />

                    <Grid Margin="0,22,0,8">
                        <TextBlock Text="Games to pack" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="All" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Click="SelectAll_Click" />
                            <Button Content="None" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="2,0,0,0" Click="SelectNone_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#111620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                        <ListBox x:Name="GamesList"
                                 Height="220"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1B2230" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource CheckBoxStyle}">
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FolderName}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock x:Name="SelectionText"
                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               Margin="2,8,0,0" Text="Select the games to include." />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,18" />

                    <CheckBox x:Name="IncludeLauncherCheckBox"
                              Style="{StaticResource CheckBoxStyle}"
                              Content="Include original launcher catalog + cover cache"
                              IsChecked="True"
                              Checked="IncludeLauncher_Changed"
                              Unchecked="IncludeLauncher_Changed" />
                    <TextBlock x:Name="LauncherDataStatusText"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="27,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Sanitized: only public game metadata and cover images. Account, token, profile and review data are never copied."
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               Margin="27,5,0,0" TextWrapping="Wrap" />

                    <TextBlock x:Name="EstimateText"
                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               Margin="0,18,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Saves stored inside the selected game folders are included. Saves kept in Documents or AppData are not automatically copied. Packing large games takes time and needs free space on the destination drive."
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0E121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="30,0">
                    <TextBlock Text="The pack contains game files and cover art — do not publish it."
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Close_Click" />
                        <Button x:Name="PackButton"
                                Content="Pack now"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0"
                                Click="Pack_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress overlay -->
            <Border x:Name="ProgressOverlay"
                    Grid.RowSpan="3"
                    Background="#F20B0D12"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <Image Source="Assets/logo.png" Width="54" Height="54" HorizontalAlignment="Center" Opacity="0.95" />
                    <TextBlock Text="Packing for transport"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock x:Name="PhaseText"
                               Text="Preparing…"
                               FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="CurrentFileText"
                               Text=""
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Width="500" Margin="0,10,0,18" />
                    <ProgressBar x:Name="Progress"
                                 Style="{StaticResource ProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="BytesText"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <Button Content="Cancel packing"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0"
                            Click="CancelPacking_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
