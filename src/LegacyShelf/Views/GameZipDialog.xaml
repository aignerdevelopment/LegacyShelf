<Window x:Class="LegacyShelf.Views.GameZipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unpack game zips"
        Width="760" Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0E121A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                               FontSize="15" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Unpack game zips" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,22,30,20">
                    <TextBlock Text="Packed games found" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="These game zips are in the LegacyShelf folder but their game folders are not unpacked yet. The launcher remembers them and hides them until they are extracted."
                               FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,18" />

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Select zips to unpack" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="All" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Click="SelectAll_Click" />
                            <Button Content="None" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="2,0,0,0" Click="SelectNone_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#111620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                        <ListBox x:Name="ZipList" Height="260" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1B2230" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource CheckBoxStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FolderName}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock x:Name="SelectionText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               Margin="2,8,0,0" />
                    <TextBlock Text="Zips are unpacked next to LegacyShelf.exe. The zip root contains the game folder, so the result is: LegacyGames\Game Folder\..."
                               FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0E121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="30,0">
                    <TextBlock x:Name="TotalText" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" />
                        <Button x:Name="UnpackButton" Content="Unpack selected"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                                Click="Unpack_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ProgressOverlay" Grid.RowSpan="3" Background="#F20B0D12" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <Image Source="Assets/logo.png" Width="54" Height="54" HorizontalAlignment="Center" Opacity="0.95" />
                    <TextBlock Text="Unpacking games" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock x:Name="PhaseText" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="CurrentFileText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" Width="500" Margin="0,10,0,18" />
                    <ProgressBar x:Name="Progress" Style="{StaticResource ProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="BytesText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <Button Content="Cancel unpacking" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,22,0,0" Click="CancelUnpack_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
