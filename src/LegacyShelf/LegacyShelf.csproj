<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LegacyShelf</AssemblyName>
    <RootNamespace>LegacyShelf</RootNamespace>
    <ApplicationIcon>Assets\LegacyShelf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Company>LegacyShelf contributors</Company>
    <Product>LegacyShelf</Product>
    <Description>An offline, open-source shelf for installed Legacy Games libraries.</Description>
    <Copyright>0BSD — no attribution required. Unofficial project.</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\cover-index.json">
      <LogicalName>LegacyShelf.cover-index.json</LogicalName>
    </EmbeddedResource>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
