<Window x:Class="LegacyShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LegacyShelf"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Background="#0E121A" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Source="Assets/logo.png" Width="30" Height="30" />
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="LegacyShelf" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="offline shelf" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="380"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#111620"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource FlatTextBoxStyle}"
                                 Padding="38,0,14,0"
                                 AutomationProperties.Name="Search games"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Search games…"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="38,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="CountText"
                               Text="0 games"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button x:Name="RescanButton"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE72C;"
                            AutomationProperties.Name="Rescan library"
                            ToolTip="Rescan library (F5)"
                            Click="Rescan_Click" />
                    <Button x:Name="PackButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="Pack"
                            AutomationProperties.Name="Pack games for transport"
                            ToolTip="Create a portable set of games for another PC"
                            Margin="8,0,0,0"
                            Click="Pack_Click" />
                    <Button x:Name="UnzipButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="Unzip"
                            AutomationProperties.Name="Unpack game zips"
                            ToolTip="Extract packed game zips into this folder"
                            Margin="4,0,0,0"
                            Click="Unzip_Click" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE921;"
                            AutomationProperties.Name="Minimize"
                            ToolTip="Minimize"
                            Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE922;"
                            AutomationProperties.Name="Maximize or restore"
                            ToolTip="Maximize"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Content="&#xE8BB;"
                            AutomationProperties.Name="Close"
                            ToolTip="Close"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Shelf -->
            <Grid Grid.Row="1">
                <Rectangle IsHitTestVisible="False" Opacity="0.5">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.12,0.02" GradientOrigin="0.12,0.02" RadiusX="0.75" RadiusY="0.55">
                            <GradientStop Color="#1EE8B563" Offset="0" />
                            <GradientStop Color="#00E8B563" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <ListBox x:Name="GamesList"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Game library"
                         Margin="34,26,22,52"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         SelectionMode="Single"
                         SelectionChanged="GamesList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,18,24" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="Transparent"
                                        AutomationProperties.Name="{Binding Name}"
                                        MouseLeftButtonDown="GameTile_MouseLeftButtonDown"
                                        ToolTip="{Binding ToolTipText}">
                                <Border x:Name="Cover"
                                        Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="#1E2533"
                                        Background="{Binding CoverBrush}"
                                        ClipToBounds="True"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Play" Tag="{Binding}" Click="PlayMenuItem_Click" />
                                            <MenuItem Header="Open game folder" Tag="{Binding}" Click="OpenFolderMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Change artwork…" Tag="{Binding}" Click="ChangeArtworkMenuItem_Click" />
                                            <MenuItem Header="Locate executable…" Tag="{Binding}" Click="LocateExecutableMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Pack this game for transport…" Tag="{Binding}" Click="PackGameMenuItem_Click" />
                                            <MenuItem Header="Hide game" Tag="{Binding}" Click="HideGameMenuItem_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <!-- Placeholder when no artwork is available -->
                                        <Border x:Name="Placeholder"
                                                Margin="1"
                                                CornerRadius="11"
                                                Background="{StaticResource TilePlaceholderBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="38"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3B475C"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Missing / not-unpacked badge -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="10"
                                                Padding="8,4"
                                                CornerRadius="6"
                                                Background="#CC3A1F26"
                                                BorderBrush="#77E06C75"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Missing files"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F2A0A8" />
                                        </Border>
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="10"
                                                Padding="8,4"
                                                CornerRadius="6"
                                                Background="#CC182737"
                                                BorderBrush="#667CC4FF"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Not unpacked"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#A8D4FF" />
                                        </Border>

                                        <!-- Play pill -->
                                        <Border x:Name="PlayPill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="14,8"
                                                CornerRadius="8"
                                                Background="#F2E8B563"
                                                Opacity="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="11"
                                                           Foreground="#14171E"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="Play"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#14171E"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,10,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="#C98A91" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                                    <Setter Property="Foreground" Value="#7F8EA3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Cover" Property="BorderBrush" Value="#3A465C" />
                                    <Setter TargetName="Cover" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="PlayPill" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Cover" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="0,0,0,20">
                    <TextBlock Text="&#xE7B8;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="34"
                               Foreground="#3B475C"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle"
                               Text="No games yet"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                    <TextBlock x:Name="EmptyText"
                               Text="Add the folder where your games are installed."
                               FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="EmptySourcesButton"
                                Content="Open sources"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Rescan_Click" />
                        <Button x:Name="EmptyUnzipButton"
                                Content="Unpack game zips"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0"
                                Visibility="Collapsed"
                                Click="Unzip_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Scan overlay -->
                <Border x:Name="ScanOverlay"
                        Background="#F20B0D12"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <Image Source="Assets/logo.png" Width="54" Height="54" HorizontalAlignment="Center" Opacity="0.95" />
                        <TextBlock Text="Building your shelf"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0" />
                        <TextBlock x:Name="ScanMessage"
                                   Text="Scanning your library…"
                                   FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,9,0,20" />
                        <ProgressBar x:Name="ScanProgress"
                                     Style="{StaticResource ProgressBarStyle}"
                                     Minimum="0" Maximum="100" Value="0" />
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="Toast"
                        Background="#F21B2230"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" FontSize="12" Foreground="{StaticResource TextBrush}" />
                </Border>

                <TextBlock x:Name="HintText"
                           Text="Double-click to play  ·  Ctrl+F search  ·  Alt+Enter full screen"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Opacity="0.75"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,28,16"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>

